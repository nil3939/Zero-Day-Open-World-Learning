<mxfile host="app.diagrams.net">
  <diagram name="Methodology" id="methodology2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 1. Data -->
        <mxCell id="b1" value="1. Data Acquisition &amp; Preprocessing&#10;CIC-IDS2017 (5-day flows) | ~180k rows&#10;Inf/NaN Cleaning • Deduplication • Stratified Downsampling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="320" height="70" as="geometry" />
        </mxCell>

        <!-- 2. Open-world split -->
        <mxCell id="b2" value="2. Open-World Split Design&#10;Known: Brute-Force, DoS/DDoS-Wed, Web-Attack, Bot&#10;Zero-Day (held out): PortScan • DDoS • Infiltration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="360" height="70" as="geometry" />
        </mxCell>

        <!-- 3. Feature engineering -->
        <mxCell id="b3" value="3. Feature Engineering&#10;Numeric Flow Features • StandardScaler&#10;Attack-Category Label Encoding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="240" width="320" height="65" as="geometry" />
        </mxCell>

        <!-- 4. Model development -->
        <mxCell id="b4" value="4. Model Development&#10;Closed-Set Baseline (Random Forest) + 4 Open-Set Detectors&#10;Proposed: Weighted Open-Set Rejection (WOSR) Ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="345" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Row: branch out to 3 boxes: Explainability equiv, Detectors, Additional -->
        <mxCell id="b5" value="5. Open-Set Detector Signals&#10;Softmax Confidence (XGBoost)&#10;One-Class SVM • Isolation Forest&#10;Autoencoder Reconstruction Error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="230" height="85" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="Base Models:&#10;Random Forest • XGBoost&#10;One-Class SVM • Isolation Forest&#10;Autoencoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="345" y="460" width="230" height="85" as="geometry" />
        </mxCell>

        <mxCell id="b7" value="Additional Steps:&#10;Threshold Search • UADR /&#10;False-Alarm Trade-off&#10;ROC &amp; Precision-Recall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="630" y="460" width="230" height="85" as="geometry" />
        </mxCell>

        <!-- Row 5: Advanced validation branch -->
        <mxCell id="b8" value="6. Advanced Validation Framework&#10;Threshold Search (0.50–0.99) • UADR Optimization&#10;Robustness: Gaussian Noise + Adversarial Perturbation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="585" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b9" value="Unknown Class Discovery:&#10;Cluster Rejected Samples&#10;Cluster Purity • PCA Visualization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="585" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b10" value="Continual Learning:&#10;Pseudo-Label Clusters →&#10;Incremental Warm-Start Retrain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="585" width="250" height="80" as="geometry" />
        </mxCell>

        <!-- 7. Evaluation & reporting -->
        <mxCell id="b11" value="7. Evaluation &amp; Reporting&#10;Ablation Study (feature groups) • Stratified 5-Fold CV&#10;McNemar's Test • Model Comparison • Publication Figures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="700" width="380" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b12" value="Per-Family Breakdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="805" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="b13" value="Detection Latency Proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="370" y="805" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="b14" value="Feature Importance (RF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="805" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Final output oval -->
        <mxCell id="final" value="Final Output&#10;Zero-Day Attack Detection System&#10;(Open-World IDS with WOSR + Continual Learning)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#a2c4c9;strokeColor=#666666;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="900" width="320" height="90" as="geometry" />
        </mxCell>

        <!-- Edges: main spine -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>

