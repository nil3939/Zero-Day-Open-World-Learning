        <!-- b8,b9,b10 -> b11 -->
        <mxCell id="e6a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="b8" target="b11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="b9" target="b11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- b11 -> b12,b13,b14 -->
